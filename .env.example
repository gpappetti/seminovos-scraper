# Conexao com o banco PostgreSQL usado pelo dashboard (raio-x seminovos).
# Na VPS com Postgres local:
DATABASE_URL=postgresql://raio_x:TROQUE_ESSA_SENHA@localhost:5432/raio_x

# No docker-compose (servico "db"), use host "db":
# DATABASE_URL=postgresql://raio_x:TROQUE_ESSA_SENHA@db:5432/raio_x

# URL publica do app (usada no metadata do Next)
NEXTAUTH_URL=http://localhost:3000
