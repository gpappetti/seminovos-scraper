# Connection string do banco Supabase (PostgreSQL).
# Use o POOLER (IPv4) — a conexão direta db.<ref>.supabase.co usa IPv6 e pode
# não ser acessível de alguns ambientes.
#
# Porta 6543 = Transaction pooler (recomendado para cargas/apps)
# Porta 5432 = Session pooler (use se houver problema com prepared statements)
#
# ATENÇÃO: se a senha tiver caracteres especiais (! @ # etc.), o script faz o
# URL-encoding automaticamente, então cole a senha crua abaixo.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Alternativa: parâmetros separados (o script aceita qualquer um dos formatos)
# PGHOST=aws-0-us-east-1.pooler.supabase.com
# PGPORT=6543
# PGUSER=postgres.SEU_PROJECT_REF
# PGPASSWORD=SUA_SENHA
# PGDATABASE=postgres
